# ============================================================
# Boardroom – variabili d'ambiente Docker
#
# Copia questo file in ".env" e personalizza i valori.
# Il file ".env" NON va mai committato su Git (già in .gitignore).
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=boardroom
POSTGRES_USER=boardroom
POSTGRES_PASSWORD=boardroom_secret_2024

# ── Email Gmail SMTP ──────────────────────────────────────────
# Usa una "App Password" Gmail, NON la tua password Google.
# Generala su: https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=boardroom.progetto@gmail.com
SPRING_MAIL_PASSWORD=vquvpjfegiahrzbd

# Mittente visualizzato nelle email
JHIPSTER_MAIL_FROM=Boardroom <boardroom.progetto@gmail.com>

# URL pubblico dell'app (usato nei link di attivazione/reset password)
APP_BASE_URL=http://localhost:8080

# ── Sicurezza JWT ─────────────────────────────────────────────
# Genera un segreto sicuro con:  openssl rand -base64 64
